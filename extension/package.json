{
  "name": "dsh-vscode",
  "displayName": "DSH for VS Code",
  "description": "DeepSeek Harness внутри IDE: воркспейс по открытой папке, контексты, скилы и правила проекта.",
  "version": "0.1.0",
  "publisher": "dsh",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dsh",
          "title": "DSH",
          "icon": "media/dsh.svg"
        }
      ]
    },
    "views": {
      "dsh": [
        {
          "id": "dsh.chat",
          "name": "Chat",
          "type": "webview",
          "contextualTitle": "DSH"
        },
        {
          "id": "dsh.sessions",
          "name": "Sessions",
          "type": "tree",
          "contextualTitle": "DSH",
          "icon": "media/dsh.svg"
        },
        {
          "id": "dsh.context",
          "name": "Context",
          "type": "tree",
          "contextualTitle": "DSH"
        },
        {
          "id": "dsh.kanban",
          "name": "Kanban",
          "type": "tree",
          "contextualTitle": "DSH"
        }
      ]
    },
    "commands": [
      {
        "command": "dsh.newSession",
        "title": "New Session",
        "category": "DSH"
      },
      {
        "command": "dsh.switchWorkspace",
        "title": "Switch Workspace",
        "category": "DSH"
      },
      {
        "command": "dsh.reloadContext",
        "title": "Reload Context",
        "category": "DSH"
      },
      {
        "command": "dsh.openTaskBoard",
        "title": "Open Task Board",
        "category": "DSH"
      },
      {
        "command": "dsh.stopAgent",
        "title": "Stop Agent",
        "category": "DSH"
      },
      {
        "command": "dsh.showContextInspector",
        "title": "Show Context Inspector",
        "category": "DSH"
      },
      {
        "command": "dsh.resumeLastSession",
        "title": "Resume Last Session",
        "category": "DSH"
      },
      {
        "command": "dsh.openSettings",
        "title": "Open Settings",
        "category": "DSH"
      },
      {
        "command": "dsh.pruneWorkspaces",
        "title": "Prune Workspaces",
        "category": "DSH"
      },
      {
        "command": "dsh.sessions.create",
        "title": "Create Session",
        "category": "DSH",
        "icon": "$(add)"
      },
      {
        "command": "dsh.sessions.refresh",
        "title": "Refresh Sessions",
        "category": "DSH",
        "icon": "$(refresh)"
      },
      {
        "command": "dsh.sessions.select",
        "title": "Make Session Active",
        "category": "DSH"
      },
      {
        "command": "dsh.sessions.resume",
        "title": "Resume Session",
        "category": "DSH"
      },
      {
        "command": "dsh.sessions.stop",
        "title": "Stop Session",
        "category": "DSH"
      },
      {
        "command": "dsh.sessions.rename",
        "title": "Rename Session",
        "category": "DSH"
      },
      {
        "command": "dsh.sessions.delete",
        "title": "Delete Session",
        "category": "DSH"
      },
      {
        "command": "dsh.sessions.openTranscript",
        "title": "Open Transcript",
        "category": "DSH"
      },
      {
        "command": "dsh.revertLastEdit",
        "title": "Revert Last Edit",
        "category": "DSH"
      },
      {
        "command": "dsh.choosePrimaryWorkspace",
        "title": "Choose Primary Workspace",
        "category": "DSH"
      },
      {
        "command": "dsh.kanban.refresh",
        "title": "Refresh Kanban",
        "category": "DSH"
      },
      {
        "command": "dsh.kanban.openCard",
        "title": "Open Kanban Card",
        "category": "DSH"
      }
    ],
    "configuration": {
      "title": "DSH",
      "properties": {
        "dsh.executablePath": {
          "type": "string",
          "default": "dsh",
          "description": "Путь к бинарю DSH (по умолчанию — `dsh` из PATH)."
        },
        "dsh.profile": {
          "type": "string",
          "default": "acp",
          "description": "Профиль DSH-рантайма: acp (automation-only JSON-RPC stdio) или web (HTTP GUI)."
        },
        "dsh.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Поднимать DSH при открытии воркспейса."
        },
        "dsh.defaultModel": {
          "type": "string",
          "default": "deepseek-chat",
          "description": "Модель по умолчанию."
        },
        "dsh.sandboxMode": {
          "type": "string",
          "enum": [
            "read-only",
            "workspace-write",
            "danger-full-access"
          ],
          "enumDescriptions": [
            "Только чтение, правки запрещены.",
            "Запись разрешена только внутри воркспейса.",
            "Без ограничений песочницы."
          ],
          "default": "workspace-write",
          "description": "Sandbox-политика DSH."
        },
        "dsh.approvalPolicy": {
          "type": "string",
          "enum": [
            "ask",
            "auto",
            "never"
          ],
          "enumDescriptions": [
            "Спрашивать подтверждение перед каждым инструментом.",
            "Разрешать всё, что не запрещено явно.",
            "Никогда не подтверждать автоматически."
          ],
          "default": "ask",
          "description": "Политика подтверждений для инструментов агента."
        },
        "dsh.context.autoReload": {
          "type": "boolean",
          "default": true,
          "description": "Перезагружать контекст при изменении правил, скилов и манифеста."
        },
        "dsh.context.maxBytes": {
          "type": "number",
          "default": 262144,
          "minimum": 1024,
          "description": "Лимит контекст-пака в байтах."
        },
        "dsh.workspace.registryPath": {
          "type": "string",
          "default": "~/.dsh/workspaces",
          "description": "Каталог реестра воркспейсов."
        },
        "dsh.workspace.keepDays": {
          "type": "number",
          "default": 90,
          "minimum": 1,
          "description": "Сколько дней хранить запись реестра, которую не открывали (GC — команда «DSH: Prune Workspaces»)."
        },
        "dsh.workspace.graceMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "description": "Сколько минут держать процесс DSH старого воркспейса после смены папки (быстрый возврат не перезапускает его)."
        },
        "dsh.kanban.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Показывать доску задач проекта."
        },
        "dsh.telemetry.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Телеметрия (по умолчанию выключена)."
        },
        "dsh.primaryWorkspace": {
          "type": "string",
          "default": "",
          "description": "Имя primary-папки multi-root (пусто — первая по index)."
        },
        "dsh.models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Дополнительные модели профиля для формы New Session."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "dsh.sessions",
        "contents": "Сессий нет — создайте первую.\n[Создать сессию](command:dsh.sessions.create)",
        "when": "dsh.sessions.empty"
      },
      {
        "view": "dsh.sessions",
        "contents": "Рантайм DSH недоступен. [Повторить](command:dsh.sessions.refresh) · [Настройки](command:dsh.openSettings)",
        "when": "dsh.sessions.error"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dsh.sessions.create",
          "when": "view == dsh.sessions",
          "group": "navigation@1"
        },
        {
          "command": "dsh.sessions.refresh",
          "when": "view == dsh.sessions",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "dsh.sessions.resume",
          "when": "view == dsh.sessions && viewItem == dshSession",
          "group": "inline@1"
        },
        {
          "command": "dsh.sessions.stop",
          "when": "view == dsh.sessions && viewItem == dshSession.active",
          "group": "inline@2"
        },
        {
          "command": "dsh.sessions.rename",
          "when": "view == dsh.sessions && viewItem =~ /^dshSession/",
          "group": "1_edit@1"
        },
        {
          "command": "dsh.sessions.openTranscript",
          "when": "view == dsh.sessions && viewItem =~ /^dshSession/",
          "group": "2_open@1"
        },
        {
          "command": "dsh.sessions.delete",
          "when": "view == dsh.sessions && viewItem =~ /^dshSession/",
          "group": "9_danger@1"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@dsh-vscode/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/vscode": "~1.100.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
